-- 3. Toggle Invisibility
local function setTransparency(char, val)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.Transparency = val
        end
    end
end

local function SetInvisState(state)
    InvisOn = state
    playSound("rbxassetid://906086442", 0.6)
    local char = LocalPlayer.Character
    if char then
        if InvisOn then
            setTransparency(char, 0.5)
            local savedpos = char.HumanoidRootPart.CFrame
            task.wait()
            char:MoveTo(Vector3.new(-25.95, 84, 3537.55))
            task.wait(0.15)
            local Seat = Instance.new("Seat", workspace)
            Seat.Anchored = false
            Seat.CanCollide = false
            Seat.Name = "invischair"
            Seat.Transparency = 1
            Seat.Position = Vector3.new(-25.95, 84, 3537.55)
            local Weld = Instance.new("Weld", Seat)
            Weld.Part0 = Seat
            Weld.Part1 = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            Seat.CFrame = savedpos
            PulseUI:Notify({ Title = "Invisibility", Content = "Invisibility Enabled", Type = "Success", Duration = 3 })
        else
            setTransparency(char, 0)
            if workspace:FindFirstChild("invischair") then
                workspace.invischair:Destroy()
            end
            PulseUI:Notify({ Title = "Invisibility", Content = "Invisibility Disabled", Type = "Info", Duration = 3 })
        end
    end
end

-- 4. Ghost Speed Enforced
local GhostEnforceConn
local function ToggleGhost()
    GhostOn = not GhostOn
    playSound("rbxassetid://906086442", 0.6)
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        if GhostOn then
            hum.WalkSpeed = GhostSpeed
            if GhostEnforceConn then
                pcall(function() GhostEnforceConn:Disconnect() end)
                GhostEnforceConn = nil
            end
            GhostEnforceConn = RunService.Stepped:Connect(function()
                if hum and hum.WalkSpeed ~= GhostSpeed then
                    pcall(function() hum.WalkSpeed = GhostSpeed end)
                end
            end)
            PulseUI:Notify({ Title = "Ghost Speed", Content = "Enabled: " .. tostring(GhostSpeed), Type = "Success", Duration = 3 })
        else
            if GhostEnforceConn then
                pcall(function() GhostEnforceConn:Disconnect() end)
                GhostEnforceConn = nil
            end
            hum.WalkSpeed = 16
            PulseUI:Notify({ Title = "Ghost Speed", Content = "Disabled", Type = "Info", Duration = 3 })
        end
    end
end

-- 5. Touch Fling Logic
if not ReplicatedStorage:FindFirstChild("juisdfj0i32i0eidsuf0iok") then
    local detection = Instance.new("Decal")
    detection.Name = "juisdfj0i32i0eidsuf0iok"
    detection.Parent = ReplicatedStorage
end

local function startTouchFling(state)
    TouchFlingActive = state
    playSound("rbxassetid://906086442", 0.6)
    if TouchFlingActive then
        task.spawn(function()
            local movel = 0.1
            while TouchFlingActive do
                RunService.Heartbeat:Wait()
                local c = LocalPlayer.Character
                local hrp = c and c:FindFirstChild("HumanoidRootPart")

                if hrp then
                    local vel = hrp.Velocity
                    hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                    RunService.RenderStepped:Wait()
                    hrp.Velocity = vel
                    RunService.Stepped:Wait()
                    hrp.Velocity = vel + Vector3.new(0, movel, 0)
                    movel = -movel
                end
            end
        end)
        PulseUI:Notify({
            Title = "Fling Enabled",
            Content = "Fling enabled - developed by MateoScripts",
            Type = "Success",
            Duration = 3
        })
    else
        TouchFlingActive = false
        PulseUI:Notify({
            Title = "Fling Disabled",
            Content = "Fling disabled - developed by MateoScripts",
            Type = "Info",
            Duration = 3
        })
    end
end

-- Hotkeys (Z for Invis, B for Ghost)
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Z then
        SetInvisState(not InvisOn)
    elseif input.KeyCode == Enum.KeyCode.B then
        ToggleGhost()
    end
end)

-- 6. ESP Highlight
local EspHighlightEnabled = false
local EspHighlightColor = Color3.fromRGB(255, 0, 0)
local Highlights = {}

local function ApplyHighlight(player)
    if player == LocalPlayer then return end
    local function setupChar(char)
        if not char then return end
        local hl = char:FindFirstChild("ScriptsByMateo_Highlight") or Instance.new("Highlight")
        hl.Name = "ScriptsByMateo_Highlight"
        hl.Adornee = char
        hl.FillColor = EspHighlightColor
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Enabled = EspHighlightEnabled
        hl.Parent = char
        Highlights[player] = hl
    end
    if player.Character then setupChar(player.Character) end
    player.CharacterAdded:Connect(setupChar)
end

for _, p in ipairs(Players:GetPlayers()) do ApplyHighlight(p) end
Players.PlayerAdded:Connect(ApplyHighlight)

-- 7. Chat Functions
local SpamText = "ScriptsByMateo in Control!"
local SpamDelay = 2
local SpamActive = false
local ManualText = ""

local function SendChatMessage(msg)
    if msg == "" then return end
    playSound("rbxassetid://4590657391", 0.4)
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if channel then channel:SendAsync(msg) end
    else
        ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            :FindFirstChild("SayMessageRequest"):FireServer(msg, "All")
    end
end

